{
  "name": "filby-pack",
  "version": "0.1.0",
  "description": "Turns a Filby projection bundle into an npm package",
  "keywords": [
    "filby",
    "temporal",
    "reference",
    "data",
    "bundle",
    "typescript"
  ],
  "author": "Stephen Cresswell",
  "license": "ISC",
  "engines": {
    "node": ">=22.12"
  },
  "main": "index.js",
  "bin": {
    "filby-pack": "bin/filby-pack.js"
  },
  "files": [
    "index.js",
    "bin",
    "lib"
  ],
  "scripts": {
    "lint": "biome ci .",
    "test": "node --test test/*.test.js",
    "coverage": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info test/*.test.js",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.2.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acuminous/filby-pack.git"
  },
  "bugs": {
    "url": "https://github.com/acuminous/filby-pack/issues"
  },
  "homepage": "https://github.com/acuminous/filby-pack"
}
